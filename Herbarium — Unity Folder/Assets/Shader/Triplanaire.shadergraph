    "m_ObjectId": "2fe5b4690f284c8380144b826f5b238b",
    "m_Group": {
        "m_Id": "dd2d000be6c34f698ad2c6fd66858d86"
    },
    "m_Name": "TexturesBlend (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 597.0,
            "y": 412.0,
